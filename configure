#!/bin/bash
set -e
echo "Configuring torchvisionlib..."

# Locate torch
TORCH_LIB=$(Rscript --vanilla -e "cat(system.file('lib', package = 'torch'))" 2>/dev/null || echo "")
if [ -z "$TORCH_LIB" ] || [ ! -d "$TORCH_LIB" ]; then
    echo "ERROR: torch package not found"
    exit 1
fi

TORCH_INC=$(Rscript --vanilla -e "cat(system.file('include', package = 'torch'))" 2>/dev/null || echo "")
[ -z "$TORCH_INC" ] && TORCH_INC="${TORCH_LIB}/../include"

# Use inst/libs (R convention for compiled packages on Linux)
INST_LIBS="$(pwd)/inst/libs"
mkdir -p "$INST_LIBS"

echo "  Found torch libs: $TORCH_LIB"
echo "  INST_LIBS: $INST_LIBS"

# Check if libtorchvision.so exists (in inst/libs or src)
TORCHVISION_SO="${INST_LIBS}/libtorchvision.so"
if [[ ! -f "$TORCHVISION_SO" ]] && [[ -f "$(pwd)/src/libtorchvision.so" ]]; then
    # Copy from src/ if not yet in inst/libs/
    cp "$(pwd)/src/libtorchvision.so" "$INST_LIBS/"
    echo "  ✓ Copied libtorchvision.so from src/ to inst/libs/"
fi

# Build Makevars: link ONLY external dependencies (NOT -ltorchvisionlib!)
cat > src/Makevars << MAKEVARS_EOF
# Auto-generated by configure
CXX_STD = CXX17
PKG_CPPFLAGS = -I../inst/include -I${TORCH_INC}
PKG_LIBS = -L${INST_LIBS} -L${TORCH_LIB} -ltorch -lc10 -Wl,-rpath,${INST_LIBS} -Wl,-rpath,${TORCH_LIB}
MAKEVARS_EOF

# Add libtorchvision ONLY if it exists
if [[ -f "$TORCHVISION_SO" ]]; then
    echo "  ✓ libtorchvision.so found in $INST_LIBS"
    # Append to Makevars
    cat >> src/Makevars << MAKEVARS_APPEND

# Link against libtorchvision (found at configure time)
PKG_LIBS += -ltorchvision
MAKEVARS_APPEND
else
    echo "  ⚠ WARNING: libtorchvision.so not found in $INST_LIBS"
    echo "  Run: bash tools/build_libtorchvision_only.sh or tools/build_and_install.sh"
fi

echo "Configuration complete."
