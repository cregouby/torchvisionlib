# Get torch paths from the R package installation
TORCH_INCLUDE_PATH = $(shell Rscript -e "cat(system.file('include', package = 'torch'))")
TORCH_LIB_PATH = $(shell Rscript -e "cat(system.file('lib', package = 'torch'))")

TORCH_CPPFLAGS = -I"$(TORCH_INCLUDE_PATH)"
TORCH_LDFLAGS = -L"$(TORCH_LIB_PATH)" -ltorch -ltorch_cpu -lc10

# Get CUDA path from environment variable (Linux)
CUDA_HOME ?= /usr/local/cuda
CUDA_CPPFLAGS = -I$(CUDA_HOME)/include
CUDA_LDFLAGS = -L$(CUDA_HOME)/lib64 -lcudart -L$(CUDA_HOME)/lib

# Set NVCC and flags
# We need -std=c++17 for LibTorch compatibility
# We need -Xcompiler -fPIC for a shared object
NVCC = $(CUDA_HOME)/bin/nvcc
NVCCFLAGS = -O3 -std=c++17 -Xcompiler -fPIC --expt-relaxed-constexpr -D_GLIBCXX_USE_CXX11_ABI=0

# Add all flags together
PKG_CPPFLAGS = -I../inst/include/ $(TORCH_CPPFLAGS) $(CUDA_CPPFLAGS)

# Define object files
# .cpp files are compiled by $(CXX)
CPP_OBJECTS = ms_deform_attn.o
# .cu files are compiled by $(NVCC)
CU_OBJECTS = cuda/ms_deform_attn_cuda.o

# Tell Make about all our objects
OBJECTS = $(CPP_OBJECTS) $(CU_OBJECTS)

# Link against torch and cuda
PKG_LIBS = $(TORCH_LDFLAGS) $(CUDA_LDFLAGS)

# --- Compilation Rules ---

# This is the target R builds
all: $(SHLIB)

# Rule to compile .cu files in the cuda/ directory
# $< is the first prerequisite (the .cu file)
# $@ is the target (the .o file)
cuda/%.o: cuda/%.cu
	$(NVCC) $(NVCCFLAGS) $(PKG_CPPFLAGS) -c $< -o $@

# C++ files (like ms_deform_attn_R.cpp) are compiled by the default .cpp.o rule
# We just need to make sure it uses C++17
CXX_STD = CXX17

# Clean up our .o files
clean:
	rm -f $(OBJECTS)
