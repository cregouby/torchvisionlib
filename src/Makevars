# Get torch paths from the R package installation
TORCH_INCLUDE_PATH := $(shell Rscript -e "cat(system.file('include/torch/csrc/api/include', package = 'torch'))" | tail -n1)
TORCH_LIB_PATH := $(shell Rscript -e "cat(system.file('lib', package = 'torch'))" | tail -n1)

# Add debug prints
ifneq (,$(wildcard $(TORCH_INCLUDE_PATH)/torch/torch.h))
   $(warning --- VALID TORCH INCLUDE PATH: $(TORCH_INCLUDE_PATH))
else
   $(error TORCH INCLUDE PATH INVALID: $(TORCH_INCLUDE_PATH))
endif
$(warning --- TORCH_LIB_PATH: [$(TORCH_LIB_PATH)])

TORCH_CPPFLAGS = -I"$(TORCH_INCLUDE_PATH)"
TORCH_LDFLAGS = -L"$(TORCH_LIB_PATH)" -ltorch -ltorch_cpu -lc10 -ltorch_jit -Wl,-rpath,$(TORCH_LIB_PATH)

PKG_CPPFLAGS = -I../inst/include/ $(TORCH_CPPFLAGS)

# Detect the OS
UNAME := $(shell uname)
ifeq ($(UNAME), Darwin)
  # This logic is macOS-specific and finds the C++ standard library headers (like <cmath>)
  SDK_PATH=$(shell xcrun --show-sdk-path)
  PKG_CPPFLAGS += -I"$(SDK_PATH)/usr/include/c++/v1"
endif
$(warning --- SDK_PATH: $(SDK_PATH))

# Link against torch
PKG_LIBS = $(TORCH_LDFLAGS)

# Define object files
# .cpp files are compiled by $(CXX)
CPP_OBJECTS = ms_deform_attn.o

# Tell Make about all our objects
OBJECTS = $(CPP_OBJECTS)

# CUDA_HOME must exist as an env var.
ifneq (,$(CUDA_HOME))
  WITH_CUDA := 1
  # Set NVCC
  NVCC := $(CUDA_HOME)/bin/nvcc
	# We need -std=c++17 for LibTorch compatibility
	# We need -Xcompiler -fPIC for a shared object
	NVCCFLAGS = -O3 -std=c++17 -Xcompiler -fPIC --expt-relaxed-constexpr -D_GLIBCXX_USE_CXX11_ABI=0
  PKG_LIBS += -L"$(CUDA_HOME)/lib64" -lcudart
  PKG_CPPFLAGS += -I"$(CUDA_HOME)/include" -DWITH_CUDA
	# .cu files are compiled by $(NVCC)
	OBJECTS += cuda/ms_deform_attn_cuda.o
endif
$(warning --- WITH_CUDA: $(WITH_CUDA))

# --- Compilation Rules ---

# This is the target R builds
all: $(SHLIB)

# Rule to compile .cu files in the cuda/ directory
# $< is the first prerequisite (the .cu file)
# $@ is the target (the .o file)
cuda/%.o: cuda/%.cu
	$(NVCC) $(NVCCFLAGS) $(PKG_CPPFLAGS) -c $< -o $@

# C++ files (like ms_deform_attn_R.cpp) are compiled by the default .cpp.o rule
# We just need to make sure it uses C++17
CXX_STD = CXX17

# Clean up our .o files
clean:
	rm -f $(OBJECTS)
