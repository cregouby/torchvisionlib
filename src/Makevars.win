# Get torch paths from the R package installation
TORCH_INCLUDE_PATH = $(shell Rscript -e "cat(system.file('include/torch/csrc/api/include', package = 'torch'))")
TORCH_LIB_PATH = $(shell Rscript -e "cat(system.file('lib', package = 'torch'))")

# Add debug prints
$(warning --- TORCH_INCLUDE_PATH: $(TORCH_INCLUDE_PATH))
$(warning --- TORCH_LIB_PATH: $(TORCH_LIB_PATH))

TORCH_CPPFLAGS = -I"$(TORCH_INCLUDE_PATH)"
TORCH_LDFLAGS = -L"$(TORCH_LIB_PATH)" -ltorch -ltorch_cpu -lc10

# Find CUDA_PATH (Windows equivalent of CUDA_HOME)
# Users must have CUDA_PATH set in their environment
CUDA_CPPFLAGS = -I"$(CUDA_PATH)/include"
CUDA_LDFLAGS = -L"$(CUDA_PATH)/lib/x64" -lcudart

# Compiler flags
# We need C++17 for LibTorch
CXX_STD = CXX17
PKG_CPPFLAGS = -I../inst/include/ $(TORCH_CPPFLAGS) $(CUDA_CPPFLAGS)

# Define object files
CPP_OBJECTS = ms_deform_attn.o
CU_OBJECTS = cuda/ms_deform_attn_cuda.o
OBJECTS = $(CPP_OBJECTS) $(CU_OBJECTS)

# Link against torch and cuda
PKG_LIBS = $(TORCH_LDFLAGS) $(CUDA_LDFLAGS)

# --- Compilation Rules ---
all: $(SHLIB)

# Rule to compile .cu files
# This is the tricky part. We need nvcc.
# We also need to tell nvcc to use the MinGW g++ as its host compiler
# This assumes Rtools40+ (MinGW 64-bit) and that g++ is in the PATH
NVCC = "$(CUDA_PATH)/bin/nvcc.exe"
NVCCFLAGS = -O3 -std=c++17 -Xcompiler -fPIC --expt-relaxed-constexpr -ccbin g++ -D_GLIBCXX_USE_CXX11_ABI=0

# Rule for .cu files in the cuda/ directory
cuda/%.o: cuda/%.cu
	$(NVCC) $(NVCCFLAGS) $(PKG_CPPFLAGS) -c $< -o $@

# Clean up
clean:
	rm -f $(OBJECTS)
